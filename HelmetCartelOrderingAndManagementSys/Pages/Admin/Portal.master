<%@ Master Language="C#" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Helmet Cartel Operations</title>
    <script src="/Scripts/admin/admin-toast-bootstrap.js?v=1"></script>
    <script src="/Scripts/admin/sidebar-state.js?v=1"></script>
    <script type="module" src="/Scripts/admin/session.js?v=2"></script>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/Content/images/favicon.svg" />
    <link rel="stylesheet" href="/Content/css/variables.css" />
    <link rel="stylesheet" href="/Content/css/reset.css" />
    <link rel="stylesheet" href="/Content/css/components.css?v=2" />
    <link rel="stylesheet" href="/Content/css/admin/admin.css?v=15" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body class="admin-body">
    <form id="adminForm" runat="server" novalidate>
        <%
            string currentPath = Request.AppRelativeCurrentExecutionFilePath ?? "";
            bool isInventory = currentPath.IndexOf("Inventory", StringComparison.OrdinalIgnoreCase) >= 0;
            bool isDashboard = currentPath.IndexOf("Dashboard", StringComparison.OrdinalIgnoreCase) >= 0;
            bool isOrders = currentPath.IndexOf("Orders", StringComparison.OrdinalIgnoreCase) >= 0;
            bool isCatalog = currentPath.IndexOf("Catalog", StringComparison.OrdinalIgnoreCase) >= 0;
            bool isPOS = currentPath.IndexOf("POS", StringComparison.OrdinalIgnoreCase) >= 0;
            bool isReports = currentPath.IndexOf("Reports", StringComparison.OrdinalIgnoreCase) >= 0;
            bool isUsers = currentPath.IndexOf("Users", StringComparison.OrdinalIgnoreCase) >= 0;
            bool isReviews = currentPath.IndexOf("Reviews", StringComparison.OrdinalIgnoreCase) >= 0;
            bool isVouchers = currentPath.IndexOf("Vouchers", StringComparison.OrdinalIgnoreCase) >= 0;
            bool isReturns = currentPath.IndexOf("Returns", StringComparison.OrdinalIgnoreCase) >= 0;
        %>
        <div class="admin-app">
            <!-- Sidebar -->
            <aside class="admin-sidebar" id="admin-sidebar" aria-label="Admin Navigation">
                <div class="admin-sidebar-top">
                    <!-- Brand / Logo Header -->
                    <div class="admin-sidebar-header">
                        <a href="/Pages/Admin/Inventory/Inventory.aspx" class="admin-brand" title="Helmet Cartel Operations">
                            <span class="admin-brand-title">Helmet Cartel</span>
                        </a>
                        <button type="button" class="admin-sidebar-toggle-btn" id="admin-sidebar-toggle-btn" aria-label="Collapse sidebar" aria-controls="admin-sidebar" aria-expanded="true" title="Collapse sidebar">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="9" y1="3" x2="9" y2="21"></line>
                            </svg>
                        </button>
                    </div>

                    <!-- Menu Section -->
                    <div class="admin-nav-group">
                        <div class="admin-nav-group-header">
                            <span class="admin-nav-group-title">Menu</span>
                        </div>
                        <ul class="admin-nav-list">

                            <li>
                                <a href="/Pages/Admin/Dashboard/Dashboard.aspx" class="admin-nav-link <%= isDashboard ? "active" : "" %>" title="Dashboard — Overview and Alerts">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="3" width="7" height="7"></rect>
                                        <rect x="14" y="3" width="7" height="7"></rect>
                                        <rect x="14" y="14" width="7" height="7"></rect>
                                        <rect x="3" y="14" width="7" height="7"></rect>
                                    </svg>
                                    <span>Dashboard</span>
                                </a>
                            </li>
                            <li>
                                <a href="/Pages/Admin/Orders/Orders.aspx" class="admin-nav-link <%= isOrders ? "active" : "" %>" title="Orders — Incoming Purchases and Fulfillment">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                                        <line x1="3" y1="6" x2="21" y2="6"></line>
                                        <path d="M16 10a4 4 0 0 1-8 0"></path>
                                    </svg>
                                    <span>Orders</span>
                                </a>
                            </li>
                            <li>
                                <a href="/Pages/Admin/POS/POS.aspx" class="admin-nav-link <%= isPOS ? "active" : "" %>" title="POS Counter — In-Store Sales">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                                        <line x1="1" y1="10" x2="23" y2="10"></line>
                                    </svg>
                                    <span>POS Counter</span>
                                </a>
                            </li>
                            <li>
                                <a href="/Pages/Admin/Inventory/Inventory.aspx" class="admin-nav-link <%= isInventory ? "active" : "" %>" title="Inventory — Stock Checks and Adjustments">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                                        <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                                        <line x1="12" y1="22.08" x2="12" y2="12"></line>
                                    </svg>
                                    <span>Inventory</span>
                                </a>
                            </li>
                            <li>
                                <a href="/Pages/Admin/Returns/Returns.aspx" class="admin-nav-link <%= isReturns ? "active" : "" %>" title="Returns — After-Sales Handling">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="1 4 1 10 7 10"></polyline>
                                        <polyline points="23 20 23 14 17 14"></polyline>
                                        <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path>
                                    </svg>
                                    <span>Returns</span>
                                </a>
                            </li>
                            <li>
                                <a href="/Pages/Admin/Catalog/Catalog.aspx" class="admin-nav-link <%= isCatalog ? "active" : "" %>" title="Catalog — Products, Variants, and Pricing">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                                        <polyline points="2 17 12 22 22 17"></polyline>
                                        <polyline points="2 12 12 17 22 12"></polyline>
                                    </svg>
                                    <span>Catalog</span>
                                </a>
                            </li>
                            <% if (new HelmetCartelOrderingAndManagementSys.Infrastructure.JwtTokenProvider().ValidateToken(Request.Cookies[HelmetCartelOrderingAndManagementSys.Constants.AppConstants.JwtConfiguration.AuthCookieName]?.Value)?.Role == HelmetCartelOrderingAndManagementSys.Constants.AppConstants.Roles.Admin) { %>
                            <li>
                                <a href="/Pages/Admin/Vouchers/Vouchers.aspx" class="admin-nav-link <%= isVouchers ? "active" : "" %>" title="Vouchers — Promotional Codes">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                                        <line x1="7" y1="7" x2="7.01" y2="7"></line>
                                    </svg>
                                    <span>Vouchers</span>
                                </a>
                            </li>
                            <% } %>
                            <li>
                                <a href="/Pages/Admin/Reviews/Reviews.aspx" class="admin-nav-link <%= isReviews ? "active" : "" %>" title="Reviews — Customer Feedback Moderation">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                    </svg>
                                    <span>Reviews</span>
                                </a>
                            </li>
                            <li>
                                <a href="/Pages/Admin/Reports/Reports.aspx" class="admin-nav-link <%= isReports ? "active" : "" %>" title="Reports — Sales and Inventory Analysis">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="18" y1="20" x2="18" y2="10"></line>
                                        <line x1="12" y1="20" x2="12" y2="4"></line>
                                        <line x1="6" y1="20" x2="6" y2="14"></line>
                                    </svg>
                                    <span>Reports</span>
                                </a>
                            </li>
                            <li>
                                <a href="/Pages/Admin/Users/Users.aspx" class="admin-nav-link <%= isUsers ? "active" : "" %>" title="Users — Accounts and Access Control">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="9" cy="7" r="4"></circle>
                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                    </svg>
                                    <span>Users</span>
                                </a>
                            </li>
                        </ul>
                    </div>

                </div>

                <!-- Sidebar Footer -->
                <div class="admin-sidebar-footer">
                    <a href="/Default.aspx" target="_blank" rel="noopener" class="admin-nav-link" title="Open Public Storefront">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                            <polyline points="15 3 21 3 21 9"></polyline>
                            <line x1="10" y1="14" x2="21" y2="3"></line>
                        </svg>
                        <span>Storefront</span>
                    </a>
                    <a href="javascript:void(0);" id="btnAdminSignOut" class="admin-nav-link" title="Sign Out">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                        <span>Sign Out</span>
                    </a>
                </div>
            </aside>

            <!-- Backdrop for Mobile Sidebar Drawer -->
            <div id="adminSidebarBackdrop" class="admin-sidebar-backdrop"></div>

            <!-- Workspace -->
            <main class="admin-workspace">
                <!-- Topbar Header -->
                <header class="admin-topbar">
                    <div class="admin-topbar-left">
                        <button type="button" class="admin-mobile-hamburger" id="adminMobileMenuBtn" aria-label="Open navigation" aria-controls="admin-sidebar" aria-expanded="false" title="Open Menu">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="3" y1="12" x2="21" y2="12"></line>
                                <line x1="3" y1="6" x2="21" y2="6"></line>
                                <line x1="3" y1="18" x2="21" y2="18"></line>
                            </svg>
                        </button>
                        <div class="admin-topbar-search-wrap">
                            <svg class="admin-topbar-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                            <input type="text" id="adminGlobalSearch" class="admin-topbar-search-input" placeholder="Search brand, helmet model, SKU, order, or staff..." autocomplete="off" />
                            <span class="admin-topbar-shortcut-pill" id="adminSearchShortcut">&#8984;+K</span>
                            <button type="button" class="admin-topbar-search-clear" id="adminSearchClear" aria-label="Clear search and filters" title="Clear search &amp; filters" style="display: none;">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                </svg>
                            </button>
                            <div id="adminSearchDropdown" class="admin-search-dropdown" style="display: none;"></div>
                        </div>
                    </div>

                    <div class="admin-topbar-actions">
                        <div class="admin-user-capsule" id="adminUserCapsule" title="Admin Account Settings. Click to manage profile and security.">
                            <div class="admin-user-avatar">HC</div>
                            <div class="admin-user-info">
                                <span class="admin-user-name">Staff Admin</span>
                                <span class="admin-user-role">Operations</span>
                            </div>
                            <svg class="admin-user-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </div>
                    </div>
                </header>

                <!-- Page Body Content -->
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </main>
        </div>

        <!-- Global Toast Container -->
        <div id="adminToastContainer" class="toast-container" aria-live="polite" aria-atomic="true"></div>

        <!-- Admin User Profile & Security Modal -->
        <div id="adminProfileModal" class="admin-modal-backdrop is-hidden" hidden role="dialog" aria-modal="true" aria-labelledby="adminProfileModalTitle">
            <div class="admin-modal admin-modal--lg admin-profile-modal">
                <div class="admin-modal-header">
                    <div>
                        <h3 class="admin-modal-title" id="adminProfileModalTitle">Admin Account Settings</h3>
                        <span class="admin-modal-desc-subtle">Manage personal administrator details and security credentials</span>
                    </div>
                    <button type="button" class="admin-modal-close-btn" id="btnCloseAdminProfileModal" aria-label="Close modal">&times;</button>
                </div>
                <div class="admin-profile-modal-body">
                    <!-- Section 1: Personal Information -->
                    <div class="admin-profile-card">
                        <div class="admin-profile-card-header">
                            <h4 class="admin-profile-card-title">PERSONAL INFORMATION</h4>
                            <p class="admin-profile-card-desc">Update your name and contact details for deliveries and order receipts.</p>
                        </div>
                        <form id="adminEditProfileForm" class="admin-profile-form" novalidate>
                            <div class="admin-profile-row-2col">
                                <div class="admin-form-group">
                                    <label for="adminEditFirstName" class="admin-form-label">First Name *</label>
                                    <input type="text" id="adminEditFirstName" class="admin-form-input" placeholder="e.g. Marc Kevin" required />
                                    <span class="inline-error-msg" id="errAdminFirstName"></span>
                                </div>
                                <div class="admin-form-group">
                                    <label for="adminEditLastName" class="admin-form-label">Last Name *</label>
                                    <input type="text" id="adminEditLastName" class="admin-form-input" placeholder="e.g. Del Mundo" required />
                                    <span class="inline-error-msg" id="errAdminLastName"></span>
                                </div>
                            </div>
                            <div class="admin-form-group">
                                <label for="adminEditEmail" class="admin-form-label">Email Address</label>
                                <input type="email" id="adminEditEmail" class="admin-form-input" readonly disabled />
                                <span class="admin-form-helper-text">Your primary account email cannot be changed for security purposes.</span>
                            </div>
                            <div class="admin-form-group">
                                <label for="adminEditPhone" class="admin-form-label">Mobile Phone Number</label>
                                <input type="tel" id="adminEditPhone" class="admin-form-input" placeholder="e.g. +63 917 123 4567" />
                                <span class="inline-error-msg" id="errAdminPhone"></span>
                            </div>
                            <div>
                                <button type="submit" class="admin-btn admin-btn--primary admin-profile-btn" id="btnAdminSaveProfile">
                                    Save Profile Changes
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Section 2: Password & Security -->
                    <div class="admin-profile-card">
                        <div class="admin-profile-card-header">
                            <h4 class="admin-profile-card-title">PASSWORD &amp; SECURITY</h4>
                            <p class="admin-profile-card-desc">Ensure your account uses a secure password with at least 6 characters.</p>
                        </div>
                        <form id="adminChangePasswordForm" class="admin-profile-form" novalidate>
                            <div class="admin-form-group">
                                <label for="adminPwdCurrent" class="admin-form-label">Current Password *</label>
                                <input type="password" id="adminPwdCurrent" class="admin-form-input" placeholder="Enter current password" autocomplete="current-password" required />
                                <span class="inline-error-msg" id="errAdminPwdCurrent"></span>
                            </div>
                            <div class="admin-form-group">
                                <label for="adminPwdNew" class="admin-form-label">New Password *</label>
                                <input type="password" id="adminPwdNew" class="admin-form-input" placeholder="Minimum 6 characters" autocomplete="new-password" required />
                                <span class="inline-error-msg" id="errAdminPwdNew"></span>
                            </div>
                            <div class="admin-form-group">
                                <label for="adminPwdConfirm" class="admin-form-label">Confirm New Password *</label>
                                <input type="password" id="adminPwdConfirm" class="admin-form-input" placeholder="Re-type new password" autocomplete="new-password" required />
                                <span class="inline-error-msg" id="errAdminPwdConfirm"></span>
                            </div>
                            <div>
                                <button type="submit" class="admin-btn admin-btn--primary admin-profile-btn" id="btnAdminSavePassword">
                                    Update Password
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
                <div class="admin-modal-footer">
                    <button type="button" class="btn-pill btn-pill--outline" id="btnAdminProfileSignOut" title="Sign out of administration">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="admin-mr-1">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                        <span>Sign Out</span>
                    </button>
                    <button type="button" class="btn-pill btn-pill--secondary" id="btnCloseAdminProfile">Close</button>
                </div>
            </div>
        </div>

        <!-- Sign Out Confirmation Modal -->
        <div id="adminSignOutModal" class="admin-modal-backdrop is-hidden" hidden>
            <div class="admin-modal admin-modal--confirm">
                <div class="admin-modal-icon-circle">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                </div>
                <h3 class="admin-modal-title">Sign Out Confirmation</h3>
                <p class="admin-modal-desc-subtle">
                    Are you sure you want to sign out of the Helmet Cartel management portal?
                </p>
                <div class="admin-modal-footer">
                    <button type="button" class="btn-pill btn-pill--outline" id="btnCancelSignOut">Cancel</button>
                    <button type="button" class="btn-pill btn-pill--primary" id="btnConfirmSignOut">Confirm Sign Out</button>
                </div>
            </div>
        </div>

        <!-- Shared confirmation modal for reversible admin actions -->
        <div id="adminActionConfirmModal" class="admin-modal-backdrop is-hidden" hidden>
            <div class="admin-modal admin-modal--confirm" role="dialog" aria-modal="true" aria-labelledby="adminActionConfirmTitle" aria-describedby="adminActionConfirmMessage">
                <div class="admin-modal-icon-circle">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 9v4"></path>
                        <path d="M12 17h.01"></path>
                        <path d="M10.3 3.8 2.6 17.2a2 2 0 0 0 1.7 3h15.4a2 2 0 0 0 1.7-3L13.7 3.8a2 2 0 0 0-3.4 0Z"></path>
                    </svg>
                </div>
                <h3 class="admin-modal-title" id="adminActionConfirmTitle">Confirm action</h3>
                <p class="admin-modal-desc-subtle" id="adminActionConfirmMessage">Are you sure you want to continue?</p>
                <div class="admin-modal-footer">
                    <button type="button" class="btn-pill btn-pill--outline" id="btnCancelAdminAction">Cancel</button>
                    <button type="button" class="btn-pill btn-pill--primary" id="btnConfirmAdminAction">Confirm</button>
                </div>
            </div>
        </div>
    </form>
    <script src="/Scripts/admin/admin.js?v=18"></script>
    <script src="/Scripts/admin/search-history.js?v=1"></script>
    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server" />
</body>
</html>
