<%@ Master Language="C#" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Helmet Cartel Operations</title>
    <link rel="stylesheet" href="/Content/css/variables.css" />
    <link rel="stylesheet" href="/Content/css/reset.css" />
    <link rel="stylesheet" href="/Content/css/components.css" />
    <link rel="stylesheet" href="/Content/css/admin/admin.css?v=5" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body class="admin-body">
    <form id="adminForm" runat="server">
        <%
            string currentPath = Request.AppRelativeCurrentExecutionFilePath ?? "";
            bool isInventory = currentPath.IndexOf("Inventory", StringComparison.OrdinalIgnoreCase) >= 0;
            bool isDashboard = currentPath.IndexOf("Dashboard", StringComparison.OrdinalIgnoreCase) >= 0;
            bool isOrders = currentPath.IndexOf("Orders", StringComparison.OrdinalIgnoreCase) >= 0;
            bool isCatalog = currentPath.IndexOf("Catalog", StringComparison.OrdinalIgnoreCase) >= 0;
            bool isPOS = currentPath.IndexOf("POS", StringComparison.OrdinalIgnoreCase) >= 0;
            bool isReports = currentPath.IndexOf("Reports", StringComparison.OrdinalIgnoreCase) >= 0;
            bool isUsers = currentPath.IndexOf("Users", StringComparison.OrdinalIgnoreCase) >= 0;
            string selectedBrand = Request.QueryString["brand"] ?? "";
        %>
        <div class="admin-app">
            <!-- Sidebar -->
            <aside class="admin-sidebar" id="admin-sidebar" aria-label="Admin Navigation">
                <div class="admin-sidebar-top">
                    <!-- Brand / Logo Header -->
                    <div class="admin-sidebar-header">
                        <a href="/Admin/Inventory.aspx" class="admin-brand" title="Helmet Cartel Operations">
                            <span class="admin-brand-title">Helmet Cartel</span>
                        </a>
                        <button type="button" class="admin-sidebar-toggle-btn" id="admin-sidebar-toggle-btn" aria-label="Toggle Sidebar" title="Collapse sidebar">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="9" y1="3" x2="9" y2="21"></line>
                            </svg>
                        </button>
                    </div>

                    <!-- Menu Section -->
                    <div class="admin-nav-group">
                        <div class="admin-nav-group-header">
                            <span class="admin-nav-group-title">Menu</span>
                        </div>
                        <ul class="admin-nav-list">
                            <li>
                                <a href="/Admin/Dashboard.aspx" class="admin-nav-link <%= isDashboard ? "active" : "" %>" title="Dashboard">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="3" width="7" height="7"></rect>
                                        <rect x="14" y="3" width="7" height="7"></rect>
                                        <rect x="14" y="14" width="7" height="7"></rect>
                                        <rect x="3" y="14" width="7" height="7"></rect>
                                    </svg>
                                    <span>Dashboard</span>
                                </a>
                            </li>
                            <li>
                                <a href="/Admin/Inventory.aspx" class="admin-nav-link <%= isInventory ? "active" : "" %>" title="Inventory Management">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                                        <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                                        <line x1="12" y1="22.08" x2="12" y2="12"></line>
                                    </svg>
                                    <span>Inventory</span>
                                </a>
                            </li>
                            <li>
                                <a href="/Admin/Orders.aspx" class="admin-nav-link <%= isOrders ? "active" : "" %>" title="Orders">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                                        <line x1="3" y1="6" x2="21" y2="6"></line>
                                        <path d="M16 10a4 4 0 0 1-8 0"></path>
                                    </svg>
                                    <span>Orders</span>
                                </a>
                            </li>
                            <li>
                                <a href="/Admin/Catalog.aspx" class="admin-nav-link <%= isCatalog ? "active" : "" %>" title="Catalog Management">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                                        <polyline points="2 17 12 22 22 17"></polyline>
                                        <polyline points="2 12 12 17 22 12"></polyline>
                                    </svg>
                                    <span>Catalog</span>
                                </a>
                            </li>
                            <li>
                                <a href="/Admin/POS.aspx" class="admin-nav-link <%= isPOS ? "active" : "" %>" title="Point of Sale">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                                        <line x1="1" y1="10" x2="23" y2="10"></line>
                                    </svg>
                                    <span>POS Counter</span>
                                </a>
                            </li>
                            <li>
                                <a href="/Admin/Reports.aspx" class="admin-nav-link <%= isReports ? "active" : "" %>" title="Analytics & Reports">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="18" y1="20" x2="18" y2="10"></line>
                                        <line x1="12" y1="20" x2="12" y2="4"></line>
                                        <line x1="6" y1="20" x2="6" y2="14"></line>
                                    </svg>
                                    <span>Analytics</span>
                                </a>
                            </li>
                            <li>
                                <a href="/Admin/Users.aspx" class="admin-nav-link <%= isUsers ? "active" : "" %>" title="Users & Access Control">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="9" cy="7" r="4"></circle>
                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                    </svg>
                                    <span>Users</span>
                                </a>
                            </li>
                        </ul>
                    </div>

                    <!-- Brands List Section -->
                    <div class="admin-nav-group">
                        <div class="admin-nav-group-header">
                            <span class="admin-nav-group-title">Brands List</span>
                            <span class="admin-nav-group-title">&mdash;</span>
                        </div>
                        <ul class="admin-sub-list">
                            <li><a href="/Admin/Inventory.aspx?brand=Shoei" class="admin-sub-link <%= string.Equals(selectedBrand, "Shoei", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">Shoei</a></li>
                            <li><a href="/Admin/Inventory.aspx?brand=AGV" class="admin-sub-link <%= string.Equals(selectedBrand, "AGV", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">AGV</a></li>
                            <li><a href="/Admin/Inventory.aspx?brand=HNJ" class="admin-sub-link <%= string.Equals(selectedBrand, "HNJ", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">HNJ</a></li>
                            <li><a href="/Admin/Inventory.aspx?brand=Gille" class="admin-sub-link <%= string.Equals(selectedBrand, "Gille", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">Gille</a></li>
                            <li><a href="/Admin/Inventory.aspx?brand=Zebra" class="admin-sub-link <%= string.Equals(selectedBrand, "Zebra", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">Zebra</a></li>
                        </ul>
                    </div>
                </div>

                <!-- Sidebar Footer -->
                <div class="admin-sidebar-footer">
                    <a href="/Default.aspx" target="_blank" rel="noopener" class="admin-nav-link" title="Open Public Storefront">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                            <polyline points="15 3 21 3 21 9"></polyline>
                            <line x1="10" y1="14" x2="21" y2="3"></line>
                        </svg>
                        <span>Storefront</span>
                    </a>
                    <a href="javascript:void(0);" id="btnAdminSignOut" class="admin-nav-link" title="Sign Out">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                        <span>Sign Out</span>
                    </a>
                </div>
            </aside>

            <!-- Backdrop for Mobile Sidebar Drawer -->
            <div id="adminSidebarBackdrop" class="admin-sidebar-backdrop"></div>

            <!-- Workspace -->
            <main class="admin-workspace">
                <!-- Topbar Header -->
                <header class="admin-topbar">
                    <div class="admin-topbar-left">
                        <button type="button" class="admin-mobile-hamburger" id="adminMobileMenuBtn" aria-label="Toggle Mobile Navigation" title="Open Menu">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="3" y1="12" x2="21" y2="12"></line>
                                <line x1="3" y1="6" x2="21" y2="6"></line>
                                <line x1="3" y1="18" x2="21" y2="18"></line>
                            </svg>
                        </button>
                        <div class="admin-topbar-search-wrap">
                            <svg class="admin-topbar-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                            <input type="text" id="adminGlobalSearch" class="admin-topbar-search-input" placeholder="Search brand, helmet model, SKU, order, or staff..." autocomplete="off" />
                            <span class="admin-topbar-shortcut-pill">&#8984;+K</span>
                            <div id="adminSearchDropdown" class="admin-search-dropdown" style="display: none;"></div>
                        </div>
                    </div>

                    <div class="admin-topbar-actions">
                        <div class="admin-user-capsule" id="adminUserCapsule" title="Signed in as Administrator. Click to sign out.">
                            <div class="admin-user-avatar">HC</div>
                            <div class="admin-user-info">
                                <span class="admin-user-name">Staff Admin</span>
                                <span class="admin-user-role">Operations</span>
                            </div>
                            <svg class="admin-user-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </div>
                    </div>
                </header>

                <!-- Page Body Content -->
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </main>
        </div>

        <!-- Global Toast Container -->
        <div id="adminToastContainer" class="admin-toast-container" aria-live="polite" aria-atomic="true"></div>

        <!-- Sign Out Confirmation Modal -->
        <div id="adminSignOutModal" class="admin-modal-backdrop is-hidden" hidden>
            <div class="admin-modal admin-modal--confirm">
                <div class="admin-modal-icon-circle">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                </div>
                <h3 class="admin-modal-title">Sign Out Confirmation</h3>
                <p class="admin-modal-desc-subtle">
                    Are you sure you want to sign out of the Helmet Cartel management portal?
                </p>
                <div class="admin-modal-footer">
                    <button type="button" class="btn-pill btn-pill--outline" id="btnCancelSignOut">Cancel</button>
                    <button type="button" class="btn-pill btn-pill--primary" id="btnConfirmSignOut">Confirm Sign Out</button>
                </div>
            </div>
        </div>
    </form>
    <script src="/Scripts/admin/admin.js?v=6"></script>
    <script src="/Scripts/admin/search-history.js?v=1"></script>
</body>
</html>
