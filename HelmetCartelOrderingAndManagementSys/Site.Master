<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="HelmetCartelOrderingAndManagementSys.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> &mdash; Helmet Cartel</title>
    <meta name="description" content="Helmet Cartel &mdash; Premium Motorcycle Helmets &amp; Riding Gear with Real-Time Stock Management." />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" runat="server" />
    <link rel="icon" type="image/svg+xml" href="~/Content/images/favicon.svg" runat="server" />

    <!-- Design System Tokens & Modular Stylesheets -->
    <link rel="stylesheet" href="~/Content/css/variables.css?v=4" runat="server" />
    <link rel="stylesheet" href="~/Content/css/reset.css?v=3" runat="server" />
    <link rel="stylesheet" href="~/Content/css/layout.css?v=6" runat="server" />
    <link rel="stylesheet" href="~/Content/css/components.css?v=4" runat="server" />
    <link rel="stylesheet" href="~/Content/css/storefront/storefront.css?v=11" runat="server" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form runat="server">
        <!-- 1. Top Announcement Bar -->
        <div class="top-bar">
            <div class="top-bar__content">
                <span>Find a helmet ready for your next ride.</span>
                <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Shop/Shop.aspx" CssClass="top-bar__link">Shop Helmets</asp:HyperLink>
            </div>
            <button type="button" class="top-bar__close" aria-label="Close Announcement">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>

        <!-- 2. Header Navigation (Monochrome, Fitted Vector Icons) -->
        <header class="main-header">
            <div class="container main-header__inner">
                <div class="main-header__left">
                    <!-- Mobile Navigation Hamburger Toggle -->
                    <button type="button" class="nav-mobile-toggle" id="mobile-nav-toggle" aria-label="Open mobile navigation">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="3" y1="12" x2="21" y2="12"></line>
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <line x1="3" y1="18" x2="21" y2="18"></line>
                        </svg>
                    </button>

                    <asp:HyperLink runat="server" NavigateUrl="~/Default.aspx" CssClass="brand-logo">HELMET CARTEL</asp:HyperLink>
                </div>

                <nav class="nav-menu">
                    <div class="nav-item--has-mega">
                        <asp:HyperLink runat="server" ID="shopMegaTrigger" ClientIDMode="Static" NavigateUrl="~/Pages/Storefront/Shop/Shop.aspx" CssClass="nav-menu__link nav-menu__link--shop">
                            <span>Shop</span>
                            <svg class="chevron-icon" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </asp:HyperLink>
                    </div>
                    <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Shop/Shop.aspx?onSale=1" CssClass="nav-menu__link">On Sale</asp:HyperLink>
                    <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Shop/Shop.aspx?sortBy=newest" CssClass="nav-menu__link">New Arrivals</asp:HyperLink>
                    <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Shop/Shop.aspx#filter-brands-container" CssClass="nav-menu__link">Brands</asp:HyperLink>
                </nav>

                <!-- Search Capsule with Live Auto-Suggestions -->
                <div class="nav-search" id="nav-search-container">
                    <span class="nav-search__icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </span>
                    <input type="text" class="nav-search__input" id="nav-search-input" placeholder="Search for helmets, visors, gear..." autocomplete="off" />
                    <span class="nav-search__shortcut" id="nav-search-shortcut">&#8984;+K</span>
                    <button type="button" class="nav-search__clear" id="nav-search-clear" aria-label="Clear search query">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                    <!-- Live Search Suggestions Container -->
                    <div class="nav-search-dropdown" id="nav-search-dropdown"></div>
                </div>

                <div class="nav-actions">
                    <!-- Shopping Cart Icon (Triggers Sliding Cart Drawer) -->
                    <asp:HyperLink runat="server" ID="navCartBtn" ClientIDMode="Static" NavigateUrl="~/Pages/Storefront/Cart/Cart.aspx" CssClass="nav-action-btn" aria-label="Shopping Cart" ToolTip="View Cart">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="9" cy="21" r="1"></circle>
                            <circle cx="20" cy="21" r="1"></circle>
                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                        </svg>
                        <span class="nav-badge nav-badge--hidden">0</span>
                    </asp:HyperLink>

                    <!-- User Authentication & Account Icon -->
                    <asp:HyperLink runat="server" ID="navUserBtn" ClientIDMode="Static" NavigateUrl="~/Pages/Auth/Auth.aspx" CssClass="nav-action-btn" aria-label="Account Authentication" ToolTip="Sign In or Join the Cartel">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                    </asp:HyperLink>
                </div>
            </div>

            <!-- Full-Width Mega Menu for Shop (Spans 100% viewport width) -->
            <div class="mega-menu" id="shop-mega-menu" aria-label="Shop Catalog Mega Menu">
                <div class="container mega-menu__container">
                    <div class="mega-menu__grid">
                        <!-- Column 1: Helmet Types -->
                        <div class="mega-menu__col">
                            <h3 class="mega-menu__col-title">CATEGORIES</h3>
                            <ul class="mega-menu__list">
                                <li>
                                    <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Shop/Shop.aspx?category=full-face" CssClass="mega-menu__link">
                                        <span>Full Face Helmets</span>
                                        <svg class="nav-arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="7" y1="17" x2="17" y2="7"></line>
                                            <polyline points="7 7 17 7 17 17"></polyline>
                                        </svg>
                                    </asp:HyperLink>
                                </li>
                                <li>
                                    <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Shop/Shop.aspx?category=Modular" CssClass="mega-menu__link">
                                        <span>Modular &amp; Flip-Up</span>
                                        <svg class="nav-arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="7" y1="17" x2="17" y2="7"></line>
                                            <polyline points="7 7 17 7 17 17"></polyline>
                                        </svg>
                                    </asp:HyperLink>
                                </li>
                                <li>
                                    <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Shop/Shop.aspx?category=open-face-urban" CssClass="mega-menu__link">
                                        <span>Open Face / Retro</span>
                                        <svg class="nav-arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="7" y1="17" x2="17" y2="7"></line>
                                            <polyline points="7 7 17 7 17 17"></polyline>
                                        </svg>
                                    </asp:HyperLink>
                                </li>
                                <li>
                                    <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Shop/Shop.aspx?category=off-road-motocross" CssClass="mega-menu__link">
                                        <span>Off-Road &amp; Motocross</span>
                                        <svg class="nav-arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="7" y1="17" x2="17" y2="7"></line>
                                            <polyline points="7 7 17 7 17 17"></polyline>
                                        </svg>
                                    </asp:HyperLink>
                                </li>
                                <li>
                                    <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Shop/Shop.aspx?category=dual-sport-adventure" CssClass="mega-menu__link">
                                        <span>Dual Sport Adventure</span>
                                        <svg class="nav-arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="7" y1="17" x2="17" y2="7"></line>
                                            <polyline points="7 7 17 7 17 17"></polyline>
                                        </svg>
                                    </asp:HyperLink>
                                </li>
                            </ul>
                        </div>

                        <!-- Column 2: Brands -->
                        <div class="mega-menu__col">
                            <h3 class="mega-menu__col-title">TOP BRANDS</h3>
                            <ul class="mega-menu__list">
                                <li>
                                    <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Shop/Shop.aspx?brand=Zebra" CssClass="mega-menu__link">
                                        <span>Zebra Helmets</span>
                                        <svg class="nav-arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="7" y1="17" x2="17" y2="7"></line>
                                            <polyline points="7 7 17 7 17 17"></polyline>
                                        </svg>
                                    </asp:HyperLink>
                                </li>
                                <li>
                                    <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Shop/Shop.aspx?brand=Gille" CssClass="mega-menu__link">
                                        <span>Gille Helmets</span>
                                        <svg class="nav-arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="7" y1="17" x2="17" y2="7"></line>
                                            <polyline points="7 7 17 7 17 17"></polyline>
                                        </svg>
                                    </asp:HyperLink>
                                </li>
                                <li>
                                    <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Shop/Shop.aspx?brand=HNJ" CssClass="mega-menu__link">
                                        <span>HNJ Helmets</span>
                                        <svg class="nav-arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="7" y1="17" x2="17" y2="7"></line>
                                            <polyline points="7 7 17 7 17 17"></polyline>
                                        </svg>
                                    </asp:HyperLink>
                                </li>
                                <li>
                                    <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Shop/Shop.aspx?brand=Shoei" CssClass="mega-menu__link">
                                        <span>Shoei Philippines</span>
                                        <svg class="nav-arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="7" y1="17" x2="17" y2="7"></line>
                                            <polyline points="7 7 17 7 17 17"></polyline>
                                        </svg>
                                    </asp:HyperLink>
                                </li>
                                <li>
                                    <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Shop/Shop.aspx?brand=AGV" CssClass="mega-menu__link">
                                        <span>AGV Racing</span>
                                        <svg class="nav-arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="7" y1="17" x2="17" y2="7"></line>
                                            <polyline points="7 7 17 7 17 17"></polyline>
                                        </svg>
                                    </asp:HyperLink>
                                </li>
                            </ul>
                        </div>

                        <!-- Column 3: Color Finishes -->
                        <div class="mega-menu__col">
                            <h3 class="mega-menu__col-title">POPULAR FINISHES</h3>
                            <ul class="mega-menu__list">
                                <li>
                                    <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Shop/Shop.aspx?q=black" CssClass="mega-menu__link">
                                        <span>Matte &amp; Gloss Black</span>
                                        <svg class="nav-arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="7" y1="17" x2="17" y2="7"></line>
                                            <polyline points="7 7 17 7 17 17"></polyline>
                                        </svg>
                                    </asp:HyperLink>
                                </li>
                                <li>
                                    <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Shop/Shop.aspx?q=white" CssClass="mega-menu__link">
                                        <span>Pearl White</span>
                                        <svg class="nav-arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="7" y1="17" x2="17" y2="7"></line>
                                            <polyline points="7 7 17 7 17 17"></polyline>
                                        </svg>
                                    </asp:HyperLink>
                                </li>
                                <li>
                                    <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Shop/Shop.aspx?q=red" CssClass="mega-menu__link">
                                        <span>Racing Red</span>
                                        <svg class="nav-arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="7" y1="17" x2="17" y2="7"></line>
                                            <polyline points="7 7 17 7 17 17"></polyline>
                                        </svg>
                                    </asp:HyperLink>
                                </li>
                                <li>
                                    <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Shop/Shop.aspx?q=graphic" CssClass="mega-menu__link">
                                        <span>Graphic Editions</span>
                                        <svg class="nav-arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="7" y1="17" x2="17" y2="7"></line>
                                            <polyline points="7 7 17 7 17 17"></polyline>
                                        </svg>
                                    </asp:HyperLink>
                                </li>
                            </ul>
                        </div>

                        <!-- Column 4: Featured Spotlight -->
                        <div class="mega-menu__col mega-menu__col--featured">
                            <h3 class="mega-menu__col-title">SPOTLIGHT</h3>
                            <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/ProductDetail/ProductDetail.aspx?slug=agv-pista-gp-rr-carbon" CssClass="mega-featured-card">
                                <div class="mega-featured-card__media">
                                    <img src='<%= ResolveUrl("~/Content/images/products/helmets/agv/pistagprrgc7.webp") %>' alt="AGV Pista GP RR Carbon Racing Helmet" class="mega-featured-card__img" />
                                    <span class="mega-featured-card__badge">MOTOGP FLAGSHIP</span>
                                </div>
                                <div class="mega-featured-card__body">
                                    <h4 class="mega-featured-card__title">AGV PISTA GP RR CARBON</h4>
                                    <div class="mega-featured-card__price">&#8369;78,000</div>
                                    <div class="mega-featured-card__cta">
                                        <span>Explore Model</span>
                                        <svg class="nav-arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="7" y1="17" x2="17" y2="7"></line>
                                            <polyline points="7 7 17 7 17 17"></polyline>
                                        </svg>
                                    </div>
                                </div>
                            </asp:HyperLink>
                        </div>
                    </div>

                    <%-- Bottom Bar of Mega Menu (Optional)
                    <div class="mega-menu__bottom">
                        <div class="mega-menu__bottom-links">
                            <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Shop/Shop.aspx" CssClass="mega-menu__bottom-link">
                                <span>Browse Complete Helmets Catalog</span>
                                <svg class="nav-arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <line x1="7" y1="17" x2="17" y2="7"></line>
                                    <polyline points="7 7 17 7 17 17"></polyline>
                                </svg>
                            </asp:HyperLink>
                            <asp:HyperLink runat="server" NavigateUrl="~/Default.aspx#top-selling" CssClass="mega-menu__bottom-link">
                                <span>View Top Selling Helmets</span>
                                <svg class="nav-arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <line x1="7" y1="17" x2="17" y2="7"></line>
                                    <polyline points="7 7 17 7 17 17"></polyline>
                                </svg>
                            </asp:HyperLink>
                        </div>
                    </div>
                    --%>
                </div>
            </div>
        </header>

        <!-- 3. Dynamic Page Content -->
        <main>
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>

            <!-- Catalog discovery banner -->
            <div class="container" id="shop-cta">
                <div class="newsletter-banner">
                    <div class="newsletter-banner__content">
                        <h2 class="newsletter-banner__heading">FIND A HELMET FOR YOUR NEXT RIDE</h2>
                        <p class="newsletter-banner__copy">Browse by riding style, brand, color, and size. Check the catalog for the fit and look you want.</p>
                    </div>
                    <div class="newsletter-banner__actions">
                        <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Shop/Shop.aspx" CssClass="btn btn--white">Browse Helmets</asp:HyperLink>
                        <asp:HyperLink runat="server" NavigateUrl="~/Default.aspx#riding-styles" CssClass="newsletter-banner__secondary-link">Explore Riding Styles</asp:HyperLink>
                    </div>
                </div>
            </div>
        </main>

        <!-- 4. Global Footer -->
        <footer class="main-footer">
            <div class="container">
                <div class="footer-top">
                    <div class="footer-brand">
                        <div class="brand-logo footer-brand-title">HELMET CARTEL</div>
                        <p class="footer-brand__desc">
                            Premium motorcycle helmets and certified riding gear. Real-time inventory tracking for online and in-store riders.
                        </p>
                        <div class="footer-socials">
                            <a href="#" class="social-icon-btn" aria-label="Twitter">
                                <svg viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                            </a>
                            <a href="#" class="social-icon-btn" aria-label="Facebook">
                                <svg viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                            </a>
                            <a href="#" class="social-icon-btn" aria-label="Instagram">
                                <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                            </a>
                        </div>
                    </div>

                    <div class="footer-col">
                        <div class="footer-col__title">COMPANY</div>
                        <div class="footer-links">
                            <a href="#" class="footer-link">About Us</a>
                            <a href="#" class="footer-link">Features</a>
                            <a href="#" class="footer-link">Works</a>
                            <a href="#" class="footer-link">Careers</a>
                        </div>
                    </div>

                    <div class="footer-col">
                        <div class="footer-col__title">HELP</div>
                        <div class="footer-links">
                            <a href="#" class="footer-link">Customer Support</a>
                            <a href="#" class="footer-link">Delivery Details</a>
                            <a href="#" class="footer-link">Terms & Conditions</a>
                            <a href="#" class="footer-link">Privacy Policy</a>
                        </div>
                    </div>

                    <div class="footer-col">
                        <div class="footer-col__title">FAQ</div>
                        <div class="footer-links">
                            <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Profile/Profile.aspx" CssClass="footer-link">Account</asp:HyperLink>
                            <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Profile/Profile.aspx?tab=orders" CssClass="footer-link">Manage Deliveries</asp:HyperLink>
                            <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Profile/Profile.aspx?tab=orders" CssClass="footer-link">Orders</asp:HyperLink>
                            <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Profile/Profile.aspx?tab=payments" CssClass="footer-link">Payments</asp:HyperLink>
                        </div>
                    </div>

                    <div class="footer-col">
                        <div class="footer-col__title">RESOURCES</div>
                        <div class="footer-links">
                            <asp:HyperLink runat="server" NavigateUrl="~/Pages/Admin/Dashboard/Dashboard.aspx" CssClass="footer-link">Staff Dashboard</asp:HyperLink>
                            <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Shop/Shop.aspx" CssClass="footer-link">Catalog Filter</asp:HyperLink>
                            <a href="#" class="footer-link">HitPay Integration</a>
                            <a href="#" class="footer-link">SignalR Sync</a>
                        </div>
                    </div>
                </div>

                <div class="footer-bottom">
                    <div>Helmet Cartel © 2026. All Rights Reserved.</div>
                    <div class="payment-badges">
                        <span class="payment-badge">HitPay</span>
                        <span class="payment-badge">GCash</span>
                        <span class="payment-badge">Maya</span>
                        <span class="payment-badge">VISA</span>
                        <span class="payment-badge">Mastercard</span>
                    </div>
                </div>
            </div>
        </footer>

        <div class="toast-container"></div>

        <!-- Mobile Navigation Slide-Out Drawer -->
        <div class="mobile-nav-overlay" id="mobile-nav-overlay"></div>
        <aside class="mobile-nav-drawer" id="mobile-nav-drawer" aria-label="Mobile Navigation Drawer" aria-hidden="true">
            <div class="mobile-nav-drawer__header">
                <asp:HyperLink runat="server" NavigateUrl="~/Default.aspx" CssClass="brand-logo">HELMET CARTEL</asp:HyperLink>
                <button type="button" class="mobile-nav-drawer__close" id="mobile-nav-close" aria-label="Close navigation">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
            <div class="mobile-nav-drawer__body">
                <!-- Mobile Search Input -->
                <div class="mobile-nav-search">
                    <button type="button" id="mobile-search-btn" aria-label="Submit search">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </button>
                    <input type="text" id="mobile-search-input" placeholder="Search helmets..." />
                </div>
                <div class="mobile-search-results" id="mobile-search-results" aria-live="polite"></div>
                <div class="mobile-nav-links">
                    <div class="mobile-nav-item mobile-nav-item--accordion">
                        <button type="button" class="mobile-nav-accordion-trigger" id="mobile-shop-accordion-btn">
                            <span>Shop Categories</span>
                            <svg class="chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </button>
                        <div class="mobile-nav-accordion-panel" id="mobile-shop-accordion-panel">
                            <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Shop/Shop.aspx" CssClass="mobile-sublink">View All Helmets</asp:HyperLink>
                            <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Shop/Shop.aspx?category=full-face" CssClass="mobile-sublink">Full Face Helmets</asp:HyperLink>
                            <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Shop/Shop.aspx?category=Modular" CssClass="mobile-sublink">Modular &amp; Flip-Up</asp:HyperLink>
                            <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Shop/Shop.aspx?category=open-face-urban" CssClass="mobile-sublink">Open Face / Retro</asp:HyperLink>
                            <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Shop/Shop.aspx?category=off-road-motocross" CssClass="mobile-sublink">Off-Road &amp; Motocross</asp:HyperLink>
                            <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Shop/Shop.aspx?category=dual-sport-adventure" CssClass="mobile-sublink">Dual Sport Adventure</asp:HyperLink>
                            <span class="mobile-nav-subheading">Popular Finishes</span>
                            <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Shop/Shop.aspx?q=black" CssClass="mobile-sublink">Matte &amp; Gloss Black</asp:HyperLink>
                            <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Shop/Shop.aspx?q=white" CssClass="mobile-sublink">Pearl White</asp:HyperLink>
                            <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Shop/Shop.aspx?q=red" CssClass="mobile-sublink">Racing Red</asp:HyperLink>
                            <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Shop/Shop.aspx?q=graphic" CssClass="mobile-sublink">Graphic Editions</asp:HyperLink>
                        </div>
                    </div>
                    <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Shop/Shop.aspx?onSale=1" CssClass="mobile-nav-link">On Sale</asp:HyperLink>
                    <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Shop/Shop.aspx?sortBy=newest" CssClass="mobile-nav-link">New Arrivals</asp:HyperLink>
                    <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Shop/Shop.aspx#filter-brands-container" CssClass="mobile-nav-link">Brands</asp:HyperLink>
                    <hr class="mobile-nav-divider" />
                    <span class="mobile-nav-subheading">My Account</span>
                    <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Profile/Profile.aspx?tab=details" CssClass="mobile-nav-link">
                        <span>Account details</span>
                    </asp:HyperLink>
                    <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Profile/Profile.aspx?tab=orders" CssClass="mobile-nav-link">
                        <span>Order history</span>
                    </asp:HyperLink>
                    <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Profile/Profile.aspx?tab=wishlist" CssClass="mobile-nav-link">
                        <span>Wishlist</span>
                    </asp:HyperLink>
                    <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Profile/Profile.aspx?tab=addresses" CssClass="mobile-nav-link">
                        <span>Addresses</span>
                    </asp:HyperLink>
                    <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Profile/Profile.aspx?tab=payments" CssClass="mobile-nav-link">
                        <span>Payment history</span>
                    </asp:HyperLink>
                    <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Profile/Profile.aspx?tab=security" CssClass="mobile-nav-link">
                        <span>Security &amp; Password</span>
                    </asp:HyperLink>
                    <a href="javascript:void(0);" id="mobile-nav-logout-btn" class="mobile-nav-link mobile-nav-link--logout">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                        <span>Sign Out</span>
                    </a>
                </div>
            </div>
        </aside>

        <!-- Universal Sliding Shopping Cart Drawer -->
        <div class="cart-drawer-overlay" id="cart-drawer-overlay"></div>
        <aside class="cart-drawer" id="cart-drawer" aria-label="Quick Shopping Cart" aria-hidden="true">
            <div class="cart-drawer__header">
                <div class="cart-drawer__title-wrap">
                    <h2 class="cart-drawer__title">SHOPPING CART</h2>
                    <span class="cart-drawer__count" id="drawer-cart-count">(0 items)</span>
                </div>
                <button type="button" class="cart-drawer__close" id="cart-drawer-close" aria-label="Close cart drawer">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <!-- Scrollable Items Body -->
            <div class="cart-drawer__body" id="drawer-cart-body"></div>

            <!-- Cart Drawer Footer -->
            <div class="cart-drawer__footer" id="drawer-cart-footer">
                <div class="cart-drawer__subtotal-row">
                    <span>Subtotal</span>
                    <span class="cart-drawer__price" id="drawer-subtotal">&#8369;0</span>
                </div>
                <div class="cart-drawer__actions">
                    <asp:HyperLink runat="server" NavigateUrl="~/Pages/Storefront/Checkout/Checkout.aspx" CssClass="btn btn--primary btn--block">
                        <span>Checkout Now</span>
                        <svg class="btn-arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="7" y1="17" x2="17" y2="7"></line>
                            <polyline points="7 7 17 7 17 17"></polyline>
                        </svg>
                    </asp:HyperLink>
                    <button type="button" class="cart-drawer__view-cart-btn" id="drawer-view-cart">
                        View Cart
                    </button>
                </div>
            </div>
        </aside>

        <!-- Universal Auth Prompt Confirmation Modal -->
        <div class="auth-prompt-modal-overlay" id="auth-prompt-modal-overlay" aria-hidden="true">
            <div class="auth-prompt-modal" role="dialog" aria-modal="true" aria-labelledby="auth-modal-title">
                <button type="button" class="auth-prompt-modal__close" id="auth-modal-close-btn" aria-label="Close modal">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
                <div class="auth-prompt-modal__icon-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                </div>
                <h3 class="auth-prompt-modal__title" id="auth-modal-title">Sign In Required</h3>
                <p class="auth-prompt-modal__desc" id="auth-modal-desc">
                    Please sign in to your Helmet Cartel account before you can save favorites, add items to your shopping cart, or checkout orders.
                </p>
                <div class="auth-prompt-modal__actions">
                    <asp:HyperLink runat="server" ID="authModalSigninBtn" ClientIDMode="Static" NavigateUrl="~/Pages/Auth/Auth.aspx" CssClass="btn btn--primary btn--block">
                        <span>Sign In / Register</span>
                        <svg class="btn-arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="7" y1="17" x2="17" y2="7"></line>
                            <polyline points="7 7 17 7 17 17"></polyline>
                        </svg>
                    </asp:HyperLink>
                    <button type="button" class="btn btn--outline btn--block" id="auth-modal-cancel-btn">
                        Continue Browsing
                    </button>
                </div>
            </div>
        </div>

        <!-- Global Site Script (Mega Menu, Drawer, Badges) -->
        <script src='<%= ResolveUrl("~/Scripts/vendor/jquery-3.7.1.min.js") %>'></script>
        <script src='<%= ResolveUrl("~/Scripts/vendor/jquery.signalR-2.4.3.min.js") %>'></script>
        <script type="module" src='<%= ResolveUrl("~/Scripts/site.js?v=20261004") %>'></script>
    </form>
</body>
</html>
